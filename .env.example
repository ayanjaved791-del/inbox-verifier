# ---------------------------------------------------------------------------
# Google OAuth client (from Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth 2.0 Client ID). Create a "Web application" client and
# add http://localhost:53682/oauth2callback as an authorized redirect URI.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Gmail refresh tokens. One token per Gmail account you want to watch.
# Separate multiple tokens with commas to watch multiple accounts at once.
# Generate them with:  npm run token
# ---------------------------------------------------------------------------
GMAIL_REFRESH_TOKENS=

# Optional friendly labels, matched by position to the tokens above.
# GMAIL_ACCOUNT_1_EMAIL=primary@gmail.com
# GMAIL_ACCOUNT_2_EMAIL=second@gmail.com
# GMAIL_ACCOUNT_3_EMAIL=third@gmail.com

# ---------------------------------------------------------------------------
# Scanning behaviour
# ---------------------------------------------------------------------------
# How far back each run looks, in minutes. Default 180 (3h) with a 2h cron
# gives a small overlap so nothing is missed between runs.
LOOKBACK_MINUTES=180
# Max messages fetched per account per run.
MAX_MESSAGES=25

# ---------------------------------------------------------------------------
# Deduplication (optional). When enabled, the app labels each code email it
# has already reported and skips labelled mail on later runs. Requires the
# gmail.modify scope (see GMAIL_MARK_PROCESSED in scripts/get-refresh-token.mjs).
# ---------------------------------------------------------------------------
GMAIL_MARK_PROCESSED=false
GMAIL_PROCESSED_LABEL=CREAO/OTP-Sent

# ---------------------------------------------------------------------------
# Notifications. At least one channel is recommended.
#  - Telegram: set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID
#  - Generic webhook (Slack / Discord / Teams / your own endpoint):
#    set NOTIFY_WEBHOOK_URL
# If neither is set, results are only logged and returned from the endpoint.
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_URL=

# Send a notification even when no codes were found (default: only notify on
# new codes).
NOTIFY_ALWAYS=false

# ---------------------------------------------------------------------------
# Shared secret protecting the /api/check endpoint. Vercel automatically sends
# it as "Authorization: Bearer <CRON_SECRET>" on scheduled invocations. Set a
# long random value.
# ---------------------------------------------------------------------------
CRON_SECRET=
